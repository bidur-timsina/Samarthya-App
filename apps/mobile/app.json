{
  "expo": {
    "name": "Shubha Yatra Academy",
    "slug": "samarthya-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shubhayatra.lms"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D2B6B"
      },
      "package": "com.shubhayatra.lms",
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0D2B6B"
        }
      ],
      "expo-font"
    ],
    "scheme": "shubhayatra",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a19cae41-25f3-4a43-8e6a-82e72cfca6d3"
      }
    },
    "owner": "bidurtimsinas-organization"
  }
}
